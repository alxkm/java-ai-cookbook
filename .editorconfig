root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# two trailing spaces are a line break in markdown
trim_trailing_whitespace = false

[*.xml]
indent_size = 2

[*.{cmd,bat}]
# Windows batch files only run with CRLF
end_of_line = crlf

[{mvnw,mvnw.cmd}]
# generated by the maven wrapper, left exactly as produced
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
